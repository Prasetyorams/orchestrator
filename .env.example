# Salin menjadi .env lalu ganti nilainya sebelum dipakai sungguhan.

DB_PASSWORD=forgehub

# WAJIB diganti. Minimal 32 karakter — HS256 menolak kunci yang lebih pendek,
# dan penolakannya baru terjadi saat token pertama dibuat.
JWT_SECRET=ganti-nilai-ini-dengan-rahasia-minimal-32-karakter

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
