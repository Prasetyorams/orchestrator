# Templat .env untuk docker compose. Salin menjadi .env di folder ini, lalu
# isi sesuai mesinmu:
#
#     copy .env.example .env
#
# .env sendiri TIDAK masuk git: isinya jalur dan rahasia milik satu mesin.
# Kalau menambah variabel baru di docker-compose.yml, tambahkan juga ke
# berkas ini — dari sinilah mesin lain tahu variabel itu ada.


# Folder data OpenOrchestrator di mesin ini. docker compose memasang signing.key
# dari folder ini ke container backend.
#
# Tulis dengan garis miring MAJU walau di Windows. Nilai dari %LOCALAPPDATA%
# memakai garis miring terbalik, dan begitu digabung dengan sisa jalur di
# docker-compose.yml hasilnya campur dua gaya: Docker kadang menerimanya,
# kadang tidak, dan bedanya baru terlihat sebagai "berkas tidak ditemukan"
# di dalam container.
#
# signing.key HARUS sudah ada di folder ini sebelum "docker compose up".
# Kalau belum ada, Docker membuat FOLDER bernama signing.key dan backend
# gagal menyala.
#
# - Mesin yang sudah pernah menjalankan Orchestrator (termasuk versi .NET
#   lama) sudah punya berkasnya. JANGAN diganti: kredensial di basis datanya disandikan
#   dengan kunci itu, dan kunci lain membuat semuanya terbaca kosong.
# - Mesin baru: buat sekali dengan PowerShell.
#
#     $d = "$env:LOCALAPPDATA\JakForge\ForgeHub"; New-Item -ItemType Directory -Force $d | Out-Null
#     $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [IO.File]::WriteAllText("$d\signing.key", [Convert]::ToBase64String($b))
OPENORCHESTRATOR_DATA=C:/Users/NAMA-PENGGUNA/AppData/Local/JakForge/ForgeHub


# Kunci penanda tangan token masuk, minimal 32 karakter.
#
# Nilai di bawah SENGAJA terlalu pendek: backend menolak menyala sampai ia
# diganti. Siapa pun yang tahu nilai ini bisa membuat token admin sendiri,
# jadi templat yang langsung jalan justru berbahaya. Buat yang acak:
#
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
#
# Mengganti nilai ini aman kapan saja: token lama ditolak, dan Studio,
# JakRunner, serta activity Orchestrator masuk ulang sendiri saat ditolak.
JWT_SECRET=GANTI-SAYA


# Kata sandi PostgreSQL di container db. Pakai nilai acak (perintah yang
# sama dengan JWT_SECRET): port 5432 dibuka ke jaringan.
#
# Nilai ini hanya dipakai saat volume openorchestrator-data DIBUAT pertama kali.
# Kalau volume itu sudah ada di mesinmu, pakai kata sandi yang dulu
# (bawaan lama: forgehub) — kata sandi baru di sini tidak mengubah yang
# sudah tersimpan, dan backend akan gagal masuk ke basis datanya.
DB_PASSWORD=GANTI-SAYA


# Zona untuk batas "hari ini" di dasbor, nama IANA.
OPENORCHESTRATOR_TZ=Asia/Jakarta


# Dasbor memanggil API lewat alamatnya sendiri (/api) — server dasbor yang
# meneruskannya ke backend — jadi dasbor bisa dibuka dari alamat mana pun
# (localhost, IP LAN, VM, domain) tanpa mengisi apa pun di sini.
#
# Isi NEXT_PUBLIC_API_URL hanya kalau peramban harus memanggil API di domain
# lain secara langsung; alamat localhost diabaikan. Kalau diisi, CORS_ORIGINS
# wajib memuat alamat dasbornya, dan dasbor harus di-build ulang.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=


# ---------------------------------------------------------------------------
# Masuk dengan akun Windows Active Directory (opsional, V19)
# ---------------------------------------------------------------------------
# Mati bawaan. Kalau dinyalakan, setelan yang salah membuat backend GAGAL
# menyala dengan pesan yang menyebut variabelnya. Semua nilai di bawah hanya
# CONTOH — isi dengan domain kantor Anda sendiri.
#
# Pengguna AD tetap harus DIDAFTARKAN admin di Tenant › Pengguna (Metode masuk:
# Windows AD). Sandi AD yang benar saja tidak cukup; tidak ada pendaftaran
# otomatis, dan sandi AD tidak pernah disimpan.
AD_AUTH_ENABLED=false
# Nama tombol di layar masuk.
AD_LABEL=Windows AD
# HANYA ldaps:// (TLS, port 636), dengan nama domain controller yang sesuai
# sertifikatnya (FQDN). Beberapa server dipisah spasi.
AD_LDAP_URL=ldaps://dc01.contoh.local:636
AD_BASE_DN=DC=contoh,DC=local
# Kosong = AD_BASE_DN.
AD_USER_SEARCH_BASE=
# Kosong = (&(objectCategory=person)(objectClass=user)(sAMAccountName={0})).
AD_USER_SEARCH_FILTER=
# Masuk tanpa akun layanan: bind sebagai nama@akhiran ini (UPN).
AD_UPN_SUFFIX=contoh.local
# Akun layanan HANYA-BACA (opsional) untuk mencari akun saat admin mendaftarkan
# pengguna. Tanpa ini, identitas akun (objectGUID) ditautkan saat pengguna
# pertama kali masuk. AD_BIND_PASSWORD adalah RAHASIA, sama seperti DB_PASSWORD.
AD_BIND_DN=
AD_BIND_PASSWORD=
# DN grup yang boleh masuk, dipisah TITIK KOMA (DN memuat koma). Keanggotaan
# lewat grup bersarang dihitung. Kosong = tanpa syarat grup.
AD_ALLOWED_GROUPS=
# Sertifikat CA (PEM) yang menerbitkan sertifikat domain controller. Taruh di
# folder data mesin ini: <OPENORCHESTRATOR_DATA>/ad/ca.pem — terlihat di
# container sebagai /data/ad/ca.pem. Kosong = trust store bawaan Java (CA
# internal kantor biasanya TIDAK ada di sana). Verifikasi sertifikat tidak
# bisa dimatikan.
AD_TRUST_STORE=
AD_CONNECT_TIMEOUT_MS=5000
AD_READ_TIMEOUT_MS=10000
