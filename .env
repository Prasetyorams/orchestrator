# Dibaca otomatis oleh docker compose.
#
# Jalur ditulis dengan garis miring MAJU, walau ini Windows: nilai yang
# berasal dari %LOCALAPPDATA% memakai garis miring terbalik, dan begitu
# digabung dengan sisa jalur di docker-compose.yml hasilnya campur dua gaya.
# Docker kadang menerimanya, kadang tidak, dan bedanya baru terlihat sebagai
# "berkas tidak ditemukan" di dalam container.
FORGEHUB_DATA=C:/Users/Fajar/AppData/Local/JakForge/ForgeHub

# GANTI sebelum dipakai selain di mesin sendiri. Minimal 32 karakter untuk HS256.
JWT_SECRET=ganti-nilai-ini-dengan-rahasia-minimal-32-karakter

DB_PASSWORD=forgehub

# Zona untuk batas "hari ini" di dasbor.
FORGEHUB_TZ=Asia/Jakarta
