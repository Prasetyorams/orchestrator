# Keluaran build — dihasilkan ulang setiap kali dibangun, dan besarnya
# puluhan megabita. Yang masuk ke git adalah yang ditulis orang.
backend/target/
frontend/.next/
frontend/node_modules/
frontend/out/

# Kunci penyandian. Kalau ini masuk ke repositori, seluruh kredensial yang
# disandikan dengannya ikut terbuka bagi siapa pun yang bisa membaca repo.
signing.key

# Setelan docker compose milik SATU mesin: jalur data dan rahasianya
# (JWT_SECRET, DB_PASSWORD). Yang masuk git adalah templatnya,
# .env.example.
.env

# Cache inkremental TypeScript: dihasilkan ulang tiap kali diperiksa.
*.tsbuildinfo
/.metadata/

# Berkas milik editor dan catatan lokal. backend/bin/ adalah keluaran
# kompilasi Eclipse/STS, terpisah dari backend/target/ milik Maven.
backend/bin/
.vs/
*.user
.idea/
*.log
